<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads a dotnet-trace capture of the runtime's allocation ticks and says where the allocations come from:
       tools/alloctrace.py builds and runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
  </ItemGroup>
</Project>
