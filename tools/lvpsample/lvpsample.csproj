<Project Sdk="Microsoft.NET.Sdk">
  <!-- Where a running Sojourn's processor-drawn view spends its time: samples every thread's instruction pointer and
       sorts them into LLVM compiling, running the shaders it made, the rasteriser and the rest (tools/lvpsample.py). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
