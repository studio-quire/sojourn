<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AO's logic checked without a grid (Agents/AoEngine.cs, AoFolders.cs): Firestorm's folder format, ZHAO-II
       notecards, and the overrider's answers to the region's motions, timers, sits, water and switches.
         run it with dotnet run, the project tools/aocheck, and -p:SojournOut=(a client build output dir)
       (the default is the client's bin\Release). Exit code: the number of failed checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SojournOut Condition="'$(SojournOut)' == ''">$(MSBuildThisFileDirectory)..\..\src\Sojourn.Client\bin\Release\net10.0</SojournOut>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Sojourn.Core"><HintPath>$(SojournOut)\Sojourn.Core.dll</HintPath></Reference>
    <Reference Include="LibreMetaverse.Types"><HintPath>$(SojournOut)\LibreMetaverse.Types.dll</HintPath></Reference>
  </ItemGroup>
</Project>
