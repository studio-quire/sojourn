<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Sojourn.Launcher">

    <!-- Sojourn's glass, light blue (the user, 2026-10-30): clear glass for everything, a light blue accent for the controls
         that act (toggles, Launch), slate ink, and behind the glass only a very light blue; no other colours. -->
    <Color x:Key="InkColor">#2B3F52</Color>
    <Color x:Key="AccentColor">#7DBCEE</Color>
    <SolidColorBrush x:Key="Ink" Color="#2B3F52"/>
    <SolidColorBrush x:Key="Dim" Color="#46596B"/>
    <SolidColorBrush x:Key="Faint" Color="#7A8A99"/>
    <SolidColorBrush x:Key="Accent" Color="#7DBCEE"/>
    <SolidColorBrush x:Key="Coral" Color="#B85A52"/>
    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Wordmark">pack://application:,,,/Fonts/#Archivo Light</FontFamily>

    <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#40FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- a field: a lighter well in the glass, its rim catching the light at the top, light blue when it has the keys -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well" CornerRadius="13" Height="42" Background="#9EFFFFFF" BorderBrush="{StaticResource Rim}" BorderThickness="1">
                        <Grid Margin="14,0">
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="#B37DBCEE"/>
                            <Setter TargetName="Well" Property="Background" Value="#D9FFFFFF"/>
                        </Trigger>
                        <Trigger Property="local:Mark.Wrong" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource Coral}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Well" CornerRadius="13" Height="42" Background="#9EFFFFFF" BorderBrush="{StaticResource Rim}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="14,0" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="#B37DBCEE"/>
                            <Setter TargetName="Well" Property="Background" Value="#D9FFFFFF"/>
                        </Trigger>
                        <Trigger Property="local:Mark.Wrong" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource Coral}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- segments: a recessed track, the chosen one a raised white pill -->
    <Style x:Key="Track" TargetType="Border">
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="#142F474C"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Height" Value="40"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#F2FFFFFF"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#FFFFFFFF"/>
                            <Setter TargetName="Pill" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource InkColor}" Opacity="0.12" BlurRadius="8" ShadowDepth="1.5" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#997DBCEE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a switch: the bead slides into the accent's light -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#262B3F52" VerticalAlignment="Center">
                            <Ellipse x:Name="Bead" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource InkColor}" Opacity="0.25" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bead" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small keys: a glyph or a word, a soft light under the pointer -->
    <Style x:Key="Key" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="17" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#66FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#A6FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WordKey" TargetType="Button" BasedOn="{StaticResource Key}">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- the way in: a lens of light blue -->
    <Style x:Key="Launch" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="28">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C4E4FA" Offset="0"/>
                                    <GradientStop Color="#9ACDF3" Offset="0.55"/>
                                    <GradientStop Color="#86C1EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource AccentColor}" Opacity="0.35" BlurRadius="22" ShadowDepth="5" Direction="270"/>
                            </Border.Effect>
                        </Border>
                        <!-- the lens's own light: a bright upper rim fading down -->
                        <Border CornerRadius="28" BorderThickness="1" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B3FFFFFF" Offset="0"/>
                                    <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- an account in the list -->
    <Style x:Key="Row" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="13" Background="Transparent" Padding="14,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#73FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#59FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="4,0,0,6"/>
    </Style>

</ResourceDictionary>
